# ==========================================
# PrintLay Private Feedback Configuration
# ==========================================

# Secret password/key required to unlock /feedback-inbox
FEEDBACK_ADMIN_KEY=your_secret_admin_key_here

# Upstash Redis REST credentials for persistent feedback storage.
# Easiest path: Vercel project -> Storage tab -> Upstash -> Redis -> Create,
# then connect it to the project. Vercel injects KV_REST_API_URL +
# KV_REST_API_TOKEN automatically (no code change needed — api/feedback.js
# calls the Upstash REST API directly over fetch).
#
# For a plain Upstash account, set these instead:
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
#
# KV_URL / KV_TOKEN and REDIS_URL / REDIS_TOKEN are also accepted as fallbacks.

# Optional: Resend API Key to automatically email notifications to devjp35@gmail.com
RESEND_API_KEY=re_your_resend_api_key_here
